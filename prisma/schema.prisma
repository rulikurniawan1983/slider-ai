// Slider AI - Prisma Schema
// PostgreSQL with pgvector extension

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// AUTH MODELS (Auth.js)
// ============================================================

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          UserRole  @default(USER)
  workspaceId   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime? // Soft delete

  accounts    Account[]
  sessions    Session[]
  workspace   Workspace? @relation("UserWorkspace")
  conversations Conversation[]
  messages      Message[]
  documents     Document[]
  memories      Memory[]
  apiKeys       ApiKey[]
  auditLogs     AuditLog[]
  tasks         Task[]
  workspaceMembers WorkspaceMember[]
  agents           Agent[]

  @@index([email])
  @@index([role])
  @@index([deletedAt])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================================
// WORKSPACE & CORE MODELS
// ============================================================

model Workspace {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  ownerId     String @unique
  settings    Json       @default("{}")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deletedAt   DateTime?  // Soft delete
  owner       User @relation("UserWorkspace", fields: [ownerId], references: [id])
  conversations Conversation[]
  agents      Agent[]
  documents   Document[]
  members     WorkspaceMember[]
  memories    Memory[]
  tasks       Task[]
  auditLogs   AuditLog[]

  @@index([slug])
  @@index([ownerId])
  @@index([deletedAt])
}

model WorkspaceMember {
  id            String      @id @default(cuid())
  workspaceId   String
  userId        String
  role          MemberRole  @default(MEMBER)
  joinedAt      DateTime    @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
}

// ============================================================
// CHAT MODELS
// ============================================================

model Conversation {
  id          String      @id @default(cuid())
  title       String      @default("New Conversation")
  workspaceId String?
  userId      String
  agentId     String?
  isArchived  Boolean     @default(false)
  isPinned    Boolean     @default(false)
  metadata    Json        @default("{}")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?   // Soft delete

  workspace   Workspace?  @relation(fields: [workspaceId], references: [id])
  user        User        @relation(fields: [userId], references: [id])
  agent       Agent?      @relation(fields: [agentId], references: [id])
  messages    Message[]

  @@index([userId])
  @@index([workspaceId])
  @@index([agentId])
  @@index([isArchived])
  @@index([deletedAt])
  @@index([updatedAt])
}

model Message {
  id          String      @id @default(cuid())
  conversationId String
  userId      String
  role        MessageRole
  content     String      @db.Text
  contentType MessageContentType @default(TEXT)
  toolCalls   Json?       // Tool call information
  toolResult  Json?       // Tool result information
  citations   Json?       // RAG source citations
  metadata    Json        @default("{}")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?   // Soft delete

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([role])
  @@index([createdAt])
  @@index([deletedAt])
}

// ============================================================
// DOCUMENT & KNOWLEDGE BASE MODELS
// ============================================================

model Document {
  id          String      @id @default(cuid())
  title       String
  filename    String
  originalName String
  filePath    String      // S3 path
  fileUrl     String?     // Public/presigned URL
  mimeType    String
  fileSize    BigInt
  workspaceId String
  userId      String
  status      DocumentStatus @default(PROCESSING)
  chunkCount  Int         @default(0)
  metadata    Json        @default("{}")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?   // Soft delete

  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id])
  chunks      DocumentChunk[]

  @@index([workspaceId])
  @@index([userId])
  @@index([status])
  @@index([deletedAt])
}

model DocumentChunk {
  id          String   @id @default(cuid())
  documentId  String
  content     String   @db.Text
  contentType ChunkContentType @default(TEXT)
  chunkIndex  Int
  tokenCount  Int?
  embedding   String?  // pgvector stored as text/vec
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([chunkIndex])
}

// ============================================================
// AGENT MODELS
// ============================================================

model Agent {
  id          String      @id @default(cuid())
  name        String
  description String?
  avatar      String?
  prompt      String      @db.Text
  model       String      @default("gpt-4o-mini")
  temperature Float       @default(0.7)
  isBuiltIn   Boolean     @default(false)
  isActive    Boolean     @default(true)
  workspaceId String?
  userId      String?
  settings    Json        @default("{}")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?   // Soft delete

  workspace   Workspace?  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  tools       AgentTool[]
  conversations Conversation[]

  @@index([workspaceId])
  @@index([userId])
  @@index([isBuiltIn])
  @@index([isActive])
  @@index([deletedAt])
}

model AgentTool {
  id        String   @id @default(cuid())
  agentId   String
  toolId    String   // Reference to tool definition
  isEnabled Boolean  @default(true)
  config    Json     @default("{}")

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
}

// ============================================================
// MEMORY MODELS
// ============================================================

model Memory {
  id          String   @id @default(cuid())
  userId      String
  workspaceId String?
  content     String   @db.Text
  type        MemoryType
  importance  Int      @default(1) // 1-5
  source      String?  // Where memory came from
  expiresAt   DateTime?
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([workspaceId])
  @@index([type])
  @@index([createdAt])
}

// ============================================================
// TASK MODEL (Async operations)
// ============================================================

model Task {
  id          String   @id @default(cuid())
  userId      String
  workspaceId String?
  type        String   // document_processing, embedding_generation, etc.
  status      TaskStatus @default(PENDING)
  payload     Json     @default("{}")
  result      Json?
  error       String?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@index([type])
  @@index([createdAt])
}

// ============================================================
// API KEY MODEL
// ============================================================

model ApiKey {
  id        String   @id @default(cuid())
  userId    String
  name      String
  key       String   @unique // Encrypted
  prefix    String?  // sk_slider_...
  scopes    String[] // Read, write, admin
  lastUsed  DateTime?
  expiresAt DateTime?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isActive])
}

// ============================================================
// AUDIT LOG MODEL
// ============================================================

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  workspaceId String?
  action    String
  entity    String   // user, document, conversation, agent, etc.
  entityId  String?
  metadata  Json     @default("{}")
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([workspaceId])
  @@index([action])
  @@index([createdAt])
}

// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  SUPER_ADMIN
  ADMIN
  USER
}

enum MemberRole {
  OWNER
  ADMIN
  MEMBER
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
  TOOL
}

enum MessageContentType {
  TEXT
  MARKDOWN
  CODE
  IMAGE
  FILE
}

enum DocumentStatus {
  UPLOADED
  PROCESSING
  COMPLETED
  FAILED
  ARCHIVED
}

enum ChunkContentType {
  TEXT
  TABLE
  IMAGE
}

enum MemoryType {
  PREFERENCE
  FACT
  INTERACTION
  WORKFLOW
}

enum TaskStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}
