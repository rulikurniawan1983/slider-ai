# Slider AI - Environment Variables (example)
# Copy to .env and fill in values. Do not commit real secrets.

# App
NODE_ENV=development
NEXTAUTH_URL=http://localhost:3000
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-a-long-random-secret

# Database (PostgreSQL; Prisma uses this)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/slider_ai

# AI
OPENAI_API_KEY=sk-replace-with-your-openai-api-key

# Redis
REDIS_URL=redis://localhost:6379

# Encryption (32-byte key; used for encrypted values like API keys)
# Generate a 32-byte value, e.g.: openssl rand -hex 16
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef

# S3-compatible storage (MinIO / S3)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=slider-ai
